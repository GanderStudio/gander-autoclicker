/* ==========================================
   GANDER STUDIO — AUTOCLICKER
   Gander Night (dark theme)

   Background   #11130D
   Surface      #1A1D14
   Field        #202417
   Border       #2E3224
   Border hover #3A3E2A
   Cream        #F3E7D0
   Muted        #8A8D72
   Accent       #D98C3F
   Accent hover #E49D55
   Sage         #E6E49F
   Green        #9DB07A
   Red          #D97763

   @ASSETS@ is replaced with the assets folder at runtime.
   ========================================== */


/* ==========================================
   1. GENERAL
   ========================================== */

QMainWindow,
QDialog,
QMessageBox {
    background-color: #11130D;
}

QWidget {
    font-family: "Inter", "Cantarell", "DejaVu Sans", sans-serif;
    font-size: 13px;
    color: #F3E7D0;
}

QToolTip {
    background-color: #202417;
    color: #F3E7D0;
    border: 1px solid #3A3E2A;
    padding: 4px 8px;
}


/* ==========================================
   2. HEADER
   ========================================== */

QLabel#eyebrow {
    color: #D98C3F;
    font-size: 10px;
    font-weight: bold;
}

QLabel#title {
    color: #F3E7D0;
    font-size: 24px;
    font-weight: bold;
}

QLabel#subtitle {
    color: #8A8D72;
    font-size: 12px;
}


/* ==========================================
   3. PANEL
   ========================================== */

QFrame#panel {
    background-color: #1A1D14;
    border: 1px solid #2E3224;
    border-radius: 12px;
}

QFrame#panel QLabel {
    background-color: transparent;
}

QLabel#sectionLabel {
    color: #8A8D72;
    font-size: 10px;
    font-weight: bold;
}

QLabel#fieldLabel {
    color: #F3E7D0;
}

QFrame#divider {
    background-color: #2E3224;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

QLabel#hint {
    color: #8A8D72;
    font-size: 11px;
}


/* ==========================================
   4. INPUT FIELDS
   ========================================== */

QSpinBox,
QComboBox {
    background-color: #202417;
    color: #F3E7D0;

    border: 1px solid #2E3224;
    border-radius: 7px;

    padding: 6px 10px;
    min-height: 22px;

    selection-background-color: #3A3E2A;
    selection-color: #F3E7D0;
}

QSpinBox:hover,
QComboBox:hover {
    border-color: #3A3E2A;
}

QSpinBox:focus,
QComboBox:focus,
QComboBox:on {
    border-color: #D98C3F;
}

QSpinBox::up-button,
QSpinBox::down-button {
    subcontrol-origin: border;
    width: 22px;
    border: none;
    background: transparent;
}

QSpinBox::up-button {
    subcontrol-position: top right;
    margin-top: 3px;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    margin-bottom: 3px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #2E3224;
    border-radius: 4px;
}

QSpinBox::up-arrow {
    image: url(@ASSETS@/chevron-up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow {
    image: url(@ASSETS@/chevron-down.svg);
    width: 10px;
    height: 10px;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: url(@ASSETS@/chevron-down.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #202417;
    color: #F3E7D0;

    border: 1px solid #3A3E2A;
    outline: none;
    padding: 4px;

    selection-background-color: #3A3E2A;
    selection-color: #F3E7D0;
}


/* ==========================================
   5. SHORTCUT KEYS
   ========================================== */

QLabel#keyCap {
    background-color: #202417;
    color: #F3E7D0;

    border: 1px solid #3A3E2A;
    border-bottom: 2px solid #3A3E2A;
    border-radius: 6px;

    padding: 3px 9px;
    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 12px;
    font-weight: bold;
}

QLabel#keyPlus {
    color: #8A8D72;
}

QLabel#shortcutText {
    color: #F3E7D0;
}

QLabel#backendTag {
    color: #8A8D72;
    font-size: 11px;
}


/* ==========================================
   6. BUTTONS
   ========================================== */

QPushButton {
    background-color: #202417;
    color: #F3E7D0;

    border: 1px solid #2E3224;
    border-radius: 7px;

    padding: 7px 14px;
    min-height: 20px;
}

QPushButton:hover {
    border-color: #3A3E2A;
    background-color: #262A1C;
}

QPushButton:pressed {
    background-color: #2E3224;
}

QPushButton:focus {
    border-color: #D98C3F;
}

QPushButton:disabled {
    background-color: #161810;
    color: #5A5D4A;
    border-color: #202417;
}

/* Small "Change" button in the shortcut row */

QPushButton#secondary {
    padding: 5px 12px;
    font-size: 12px;
}

/* Start / Stop and dialog Save */

QPushButton#primary,
QPushButton#shortcutSave {
    background-color: #D98C3F;
    color: #11130D;

    border: none;
    font-weight: bold;
}

QPushButton#primary {
    border-radius: 9px;
    padding: 12px;
    font-size: 14px;
}

QPushButton#primary:hover,
QPushButton#shortcutSave:hover {
    background-color: #E49D55;
}

QPushButton#primary:pressed,
QPushButton#shortcutSave:pressed {
    background-color: #B8732F;
}

QPushButton#primary:disabled {
    background-color: #2E3224;
    color: #5A5D4A;
}

/* While clicking, the button becomes a calm "Stop" */

QPushButton#primary[running="true"] {
    background-color: #202417;
    color: #D98C3F;
    border: 1px solid #D98C3F;
}

QPushButton#primary[running="true"]:hover {
    background-color: #2A2618;
}


/* ==========================================
   7. STATUS AND FOOTER
   ========================================== */

QLabel#status {
    color: #9DB07A;
    font-size: 12px;
    font-weight: bold;
}

QLabel#status[state="running"] {
    color: #D98C3F;
}

QLabel#status[state="error"] {
    color: #D97763;
}

QLabel#footer {
    color: #5A5D4A;
    font-size: 10px;
    font-weight: bold;
}


/* ==========================================
   8. SHORTCUT DIALOG
   ========================================== */

QDialog#shortcutDialog QLabel {
    background-color: transparent;
}

QLabel#dialogTitle {
    font-size: 16px;
    font-weight: bold;
}

/* The visible field is the QLineEdit inside QKeySequenceEdit. */

QKeySequenceEdit#shortcutEditor QLineEdit {
    background-color: #202417;
    color: #F3E7D0;

    border: 1px solid #D98C3F;
    border-radius: 7px;
    padding: 8px 12px;

    font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
    font-size: 14px;

    selection-background-color: #3A3E2A;
    selection-color: #F3E7D0;
}

QPushButton#shortcutSave,
QPushButton#shortcutCancel {
    padding: 8px 18px;
    min-width: 70px;
}


/* ==========================================
   9. DIALOG BUTTONS
   No icon-theme icons on Save / Cancel / OK,
   so buttons look the same on every desktop.
   ========================================== */

QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}
